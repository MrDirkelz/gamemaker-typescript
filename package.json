{
  "name": "@odemian/gamemaker-typescript",
  "version": "1.0.0",
  "main": "bin/lib.js",
  "author": "Oleksandr Demian <oleksandrovsky@gmail.com>",
  "repository": "https://github.com/OleksandrDemian/gamemaker-typescript.git",
  "license": "MIT",
  "bin": {
    "gmts": "bin/lib.js",
    "gamemaker-typescript": "bin/lib.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "types:generate": "node scripts/generate-lts-types.mjs",
    "types:verify": "node scripts/generate-lts-types.mjs --check",
    "package:smoke": "node scripts/package-smoke.mjs",
    "test:gamemaker": "npm run build && node scripts/gamemaker-integration.mjs",
    "verify": "npm run typecheck && npm run types:verify && npm test && npm run build && npm run package:smoke",
    "prepack": "npm run build"
  },
  "files": [
    "bin/",
    "gamemaker-config/",
    "package.json",
    "yarn.lock",
    "tsconfig.json",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fs-extra": "^11.3.4",
    "json5": "^2.2.3",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "gamemaker",
    "gml",
    "typescript",
    "cli",
    "transpiler"
  ]
}
